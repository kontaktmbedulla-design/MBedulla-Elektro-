rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users collection: user can read/write their own profile
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Workers collection: accessible by authenticated team members
    match /workers/{workerId} {
      allow read, write: if isAuthenticated();
    }

    // Sites collection: accessible by authenticated team members
    match /sites/{siteId} {
      allow read, write: if isAuthenticated();
    }

    // Timesheets collection: accessible by authenticated team members
    match /timesheets/{timesheetId} {
      allow read, write: if isAuthenticated();
    }

    // Alerts collection: accessible by authenticated team members
    match /alerts/{alertId} {
      allow read, write: if isAuthenticated();
    }
  }
}
